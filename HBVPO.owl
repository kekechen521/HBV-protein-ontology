    <Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#label"/>
        <Literal xml:lang="en">HBV Protein Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#label"/>
        <Literal xml:lang="zh">乙型肝炎病毒蛋白本体</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <Literal xml:lang="en">HBVPO describes the proteins, structural components and infection-process steps of hepatitis B virus (HBV). It is organized into three top-level branches: HBV infection process (27 terms), HBV proteins (13 terms) and HBV structural component (15 terms).</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <Literal xml:lang="zh">HBVPO 描述乙型肝炎病毒（HBV）的蛋白、结构组分与感染过程，分三个顶层分支：感染过程（27 个术语）、病毒蛋白（13 个术语）、病毒结构组分（15 个术语）。</Literal>
    </Annotation>
